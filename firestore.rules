rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email == 'abdelrahmanatia167@gmail.com';
    }

    match /artifacts/abdelrahman-website/public/data/config/siteState {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site/content {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.contact is string
                    && request.resource.data.details is string;
      allow read, update, delete: if isAdmin();
    }

    match /users/{id} {
      allow create: if signedIn() && request.auth.uid == id;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow delete: if isAdmin();
    }

    match /loginIndex/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.fromAdmin == false)
                    || (isAdmin() && request.resource.data.uid is string && request.resource.data.fromAdmin == true);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && resource.data.fromAdmin == true
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.text == resource.data.text
                        && request.resource.data.sender == resource.data.sender
                        && request.resource.data.fromAdmin == resource.data.fromAdmin
                        && request.resource.data.readByClient == true);
      allow delete: if isAdmin();
    }

    match /projectImages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
